// Aging + intervention mouse RNA-seq (2 mo / 9 mo control / 9 mo + curcumin / 9 mo + plumbagin)
// nf-core/rnaseq infra + kit-specific parameters, carried over from the OB/OB project (same kit).
// Pipeline: nf-core/rnaseq, pinned to release 3.26.0 (run with `-r 3.26.0`)
// See docs/Aging_Intervention_Analysis.md for the analysis plan. Settings marked [VERIFY]
// were correct for the OB/OB data and must be re-checked against the new FASTQs.
// Rationale for the kit settings (UMI, strandedness, MT dedup) is in the archived OB/OB doc:
// D:\Govind\RNAseq_Analysis_Pipeline_OB-OB.md

// WSL2's virtualized disk returns inconsistent file mtimes across separate nextflow
// process launches, which was defeating -resume's cache (same script + same file, but a
// new hash every restart). 'lenient' drops mtime from the cache key (path+size only) —
// see docs/RNAseq_Analysis_Pipeline.md Phase 5 for the diagnosis.
cache = 'lenient'

params {
    // --- Reference ---
    fasta       = "/home/govind/data/ref/Mus_musculus.GRCm39.dna.primary_assembly.fa.gz"
    gtf         = "/home/govind/data/ref/Mus_musculus.GRCm39.116.gtf.gz"
    // Prebuilt indices from the OB/OB run (built with --sjdbOverhang 160 for 161 bp reads). Aging reads confirmed 161x161 bp (2026-09-23).
    // Reuse only if the new reads are also 161 bp [VERIFY]; otherwise delete these two lines
    // and let the pipeline rebuild with sjdbOverhang = new read length - 1.
    star_index   = "/home/govind/data/ref/nfcore_GRCm39_e116/index/star"
    salmon_index = "/home/govind/data/ref/nfcore_GRCm39_e116/index/salmon"

    // --- Library prep: SMARTer(R) Stranded Total RNA-Seq Kit v3 - Pico Input Mammalian ---
    // Source: Takara Bio official User Manual, Appendix C "Sequencing Analysis Guidelines"
    // (SMARTer Stranded Total RNA-Seq Kit v3 - Pico Input Mammalian User Manual, downloaded
    // and verified 2026-09-02 from takarabio.com).
    //
    // Quote: "First eight cycles of Read 2 belong to UMIs followed by 3 nucleotides of
    // UMI-linker and 3 nucleotides derived from the Pico v3 SMART UMI Adapter... If not using
    // CogentAP, trim 8 nt UMIs + 3 nt UMI linker + 3 nt from Pico v3 SMART UMI Adapter from
    // Read2 prior to mapping."
    // => umi_tools "string" pattern: 8 UMI bases (N) + 6 bases to discard (X) = 14 nt total.
    with_umi                 = true
    umitools_bc_pattern2     = "NNNNNNNNXXXXXX"   // Read 2 only — Read 1 carries no UMI
    umitools_extract_method  = "string"
    umitools_dedup_stats     = true

    // Aligner/quantifier: STAR + Salmon-on-alignments (nf-core default "star_salmon").
    // Chosen deliberately over pure pseudoalignment: this is ribo-depleted TOTAL RNA from a
    // Pico (low-input, degraded-RNA-tolerant) kit, so read-level alignment evidence is more
    // robust to fragmented/partial transcripts than k-mer pseudoalignment against transcripts
    // alone, and it also gives real BAMs for gene-body-coverage / degradation QC (RSeQC, Qualimap).
    aligner       = "star_salmon"

    // Strandedness: Read 1 = antisense to RNA, Read 2 = sense (Takara manual, same Appendix C
    // quoted above) => "reverse" in nf-core convention. Set explicitly rather than left to
    // "auto" since we have the authoritative answer; nf-core's own RSeQC infer_experiment.py
    // QC step still runs and will flag it in MultiQC if the empirical result ever disagrees.

    outdir        = "/home/govind/results-aging"
    email         = null

    // --- "Map everything, gate later" — keep maximum flexibility for downstream re-analysis ---
    // Statistical gating (low-count filtering, biotype subsetting) belongs in the DESeq2/edgeR
    // stage in R, on data that's already fully captured — not as an upstream restriction that
    // can't be undone. These params implement that on the pipeline side. Verified against this
    // pipeline's own nextflow_schema.json (param names + defaults) before setting, same as
    // everything else in this file.
    save_reference    = false     // reference + indices already kept once in
                                   // ~/data/ref/nfcore_GRCm39_e116 (from the OB/OB build); with
                                   // per-group outdirs, true would re-publish ~10+ GB per group.
    save_unaligned    = true      // keep reads that DIDN'T map to the genome — real analytical
                                   // value (contamination check, unannotated/novel sequence),
                                   // not just a debug artifact; default is to discard these.
    skip_preseq       = false     // Preseq is SKIPPED by default in this pipeline — turned back
                                   // on here: at ~87-144M read pairs/sample this tells us whether
                                   // we're near library-complexity saturation or whether the deep
                                   // sequencing is still buying real additional unique signal
                                   // (directly answers "did we get everything").
    pseudo_aligner    = "salmon"  // run an independent k-mer-based Salmon quantification
                                   // alongside star_salmon's alignment-based quantification —
                                   // a second, methodologically-different count matrix to cross-
                                   // validate low-abundance/non-coding calls against later.

    save_umi_intermeds = true     // publishes the genome-level UMI-deduplicated BAM + .bai to
                                   // star_salmon/ — the Track A input. In 3.26.0 it is NOT
                                   // published otherwise (umi_dedup.config saveAs → null); OB/OB
                                   // Track A read it from work/, which is wiped between groups here.

    // Deliberately left at default (off): save_trimmed, save_align_intermeds.
    // These are regenerable pipeline-internal debug artifacts (pre-dedup BAMs, intermediate
    // UMI-tools files) with no distinct analytical value over what's already published, and raw
    // FASTQs are already preserved twice (this NVMe working copy + the untouched original on
    // `D:`) — so there's nothing gained by also duplicating them mid-pipeline at real disk cost.
}

// Container engine: Apptainer (rootless, installed via conda-forge — no Docker Desktop/root
// daemon needed inside WSL2). See docs/WSL2_Environment_Setup.md.
profiles {
    apptainer {
        apptainer.enabled      = true
        apptainer.autoMounts   = true
        apptainer.cacheDir     = "/home/govind/nf-work/apptainer-cache"
        conda.enabled          = false
        docker.enabled         = false
    }
}

// Scratch/work directory kept off the git-tracked project dir and off spinning D: (see
// WSL2_Environment_Setup.md on why compute must stay on the NVMe-backed root fs).
workDir = "/home/govind/nf-work/work-aging"

executor {
    name = 'local'
}

process {
    // Machine caps (see docs/WSL2_Environment_Setup.md — Xeon w3-2435, 14 threads exposed to
    // WSL2, 220 GB RAM allotted). Leaves headroom rather than claiming 100% of the box.
    // (nf-core/rnaseq 3.26.0 uses the native Nextflow `resourceLimits` directive, not the older
    // params.max_cpus/max_memory/max_time convention — verified against this pipeline's own
    // conf/base.config test profiles before using it here.)
    resourceLimits = [
        cpus:   14,
        memory: 200.GB,
        time:   72.h
    ]

    // Reads are 161x161 bp (confirmed by direct FASTQ inspection, 2026-09-02). STAR's default
    // sjdbOverhang is 100 and nf-core/rnaseq does not derive it from the actual read length
    // (verified against conf/modules/prepare_genome.config) — left at default it under-builds
    // the splice-junction index for reads this long, so it's overridden explicitly here
    // (ideal value = max read length - 1).
    withName: 'STAR_GENOMEGENERATE' {
        ext.args = '--sjdbOverhang 160'
    }

    // Keep STAR's transcriptome BAM (Track B input: MT-filtered UMI dedup + salmon --alignments,
    // run by hand outside Nextflow). nf-core only publishes it with save_align_intermeds, which
    // would also publish the large pre-dedup genome BAMs. A publishDir here REPLACES nf-core's
    // list for this selector, so its log/ and unmapped/ entries (conf/modules/align_star.config)
    // are repeated verbatim. publishDir is not part of the task hash: re-running with -resume
    // before work-aging/ is wiped republishes cached STAR outputs without realigning.
    withName: '.*ALIGN_STAR:STAR_ALIGN|.*ALIGN_STAR:SENTIEON_STAR_ALIGN|.*ALIGN_STAR:PARABRICKS_RNA_FQ2BAM' {
        publishDir = [
            [
                path: { "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/log" },
                mode: 'copy',
                pattern: '*.{out,tab}'
            ],
            [
                path: { params.save_unaligned ? "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/unmapped" : params.outdir },
                mode: 'copy',
                pattern: '*.fastq.gz',
                saveAs: { filename -> params.save_unaligned ? filename : null }
            ],
            [
                path: { "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/transcriptome_bam" },
                mode: 'copy',
                pattern: '*.toTranscriptome.out.bam'
            ]
        ]
    }

    // Genome-level UMITOOLS_DEDUP: default 8h wasn't enough; 48h let both samples finish
    // successfully (het2 took ~8.4h, het3 was already cached). Keep this generous limit here.
    withName: 'UMITOOLS_DEDUP' {
        time = 48.h
    }

    // Transcriptome-level UMITOOLS_DEDUP (used only for the star_salmon internal Salmon
    // quantification) failed on BOTH samples even at 48h (het2: hit the cap at 393M reads
    // parsed and still climbing; het3: same, at ~20:57 Sep12). Root cause diagnosed directly:
    // the 37 mitochondrial transcripts create a ~1,300-2,000x normal read-density pileup
    // (mt-rRNA/mt-mRNA over-representation from imperfect ribo-depletion, standard for total-RNA
    // kits), and umi_tools' directional dedup algorithm scales worse than linearly with pileup
    // depth at a single position — a few positions dominate total runtime regardless of any
    // time limit raise. This is NOT fixable by raising the limit further.
    // Nuclear gene expression is unaffected either way (mitochondrial reads never map to nuclear
    // genes), and mitochondrial gene counts are unaffected too — they come from the genome-level
    // pathway above (STAR genome BAM -> genome UMITOOLS_DEDUP -> featureCounts), which never hit
    // this bottleneck since it only processes primary alignments regardless of chrMT pileup depth.
    // A methodologically-correct, MT-filtered version of this transcriptome-level Salmon
    // quantification is produced manually outside Nextflow (see docs/RNAseq_Analysis_Pipeline.md)
    // as the "second, independent count matrix" cross-check this config always intended
    // (see pseudo_aligner comment above) — so here we just fail fast (2m, not another 48h) and
    // let Nextflow proceed with every other independent output (featureCounts, RSeQC, StringTie,
    // Qualimap, bigwig, MultiQC), none of which depend on this branch.
    withName: '.*BAM_DEDUP_STATS_SAMTOOLS_UMITOOLS_TRANSCRIPTOME:UMITOOLS_DEDUP' {
        time = 2.m
        errorStrategy = 'ignore'
    }
}
